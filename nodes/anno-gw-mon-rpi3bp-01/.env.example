# -------------------------------------------------------------------
# anno-gw-mon-rpi3bp-01 — Monitoring Node
# Copy to .env and fill in real values before `docker compose up -d`.
#
# No CF_TUNNEL_TOKEN here — this node has no public ingress of its own.
# That lives on nodes/anno-gw-vps-macauba-01/, which reaches Grafana and
# Alertmanager on this box directly over Tailscale.
# -------------------------------------------------------------------

# This node's own Tailscale IP (mon-capitao in `tailscale status`). All
# monitoring ports (Prometheus, Alertmanager, Loki, the docker socket-proxy)
# are bound to this address only — never to 0.0.0.0 — so nothing here is
# reachable from the plain LAN, only from inside the tailnet.
TAILSCALE_IP=100.78.7.53

# Used as the Prometheus/Loki external label and Promtail's "host" label,
# so this node's own metrics/logs are identifiable in the cluster-wide view.
GATEWAY_ID=anno-gw-mon-rpi3bp-01

# Grafana runs on nodes/anno-gw-vps-macauba-01/, not here — no Grafana
# credentials belong in this .env. See that node's .env.example instead.

# Peer node Tailscale IPs actually live in
# prometheus-config/targets/cluster-nodes.yml (Prometheus hot-reloads that
# file, no restart or env var needed) — edit that file directly.
