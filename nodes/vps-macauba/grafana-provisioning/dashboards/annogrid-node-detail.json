{
  "uid": "annogrid-node-detail",
  "title": "AnnoGrid — Node Detail",
  "tags": ["annogrid", "node"],
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "label": "Node",
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "query": { "query": "label_values(up{job=~\"node-exporter|cluster-nodes\"}, instance)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "panels": [
    { "id": 1, "type": "row", "title": "Overview", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "id": 2, "type": "stat", "title": "Status",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "max(up{job=~\"node-exporter|cluster-nodes\", instance=\"$instance\"})", "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "time() - node_boot_time_seconds{instance=\"$instance\"}", "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Load (1m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "node_load1{instance=\"$instance\"}", "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] }
    },
    {
      "id": 5, "type": "stat", "title": "CPU Cores",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "count(count by(cpu) (node_cpu_seconds_total{instance=\"$instance\", mode=\"idle\"}))", "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] }
    },

    { "id": 6, "type": "row", "title": "CPU & Memory", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "panels": [] },
    {
      "id": 7, "type": "timeseries", "title": "CPU Usage % per Core",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "100 - (rate(node_cpu_seconds_total{instance=\"$instance\", mode=\"idle\"}[5m]) * 100)", "legendFormat": "cpu {{cpu}}", "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Memory",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "node_memory_MemTotal_bytes{instance=\"$instance\"}", "legendFormat": "Total", "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } },
        { "expr": "node_memory_MemTotal_bytes{instance=\"$instance\"} - node_memory_MemAvailable_bytes{instance=\"$instance\"}", "legendFormat": "Used", "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } },
        { "expr": "node_memory_MemAvailable_bytes{instance=\"$instance\"}", "legendFormat": "Available", "refId": "C", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 9, "type": "row", "title": "Disk", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": [] },
    {
      "id": 10, "type": "bargauge", "title": "Filesystem Usage % by Mountpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "(1 - (node_filesystem_avail_bytes{instance=\"$instance\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{instance=\"$instance\", fstype!~\"tmpfs|overlay\"})) * 100", "legendFormat": "{{mountpoint}}", "refId": "A", "instant": true, "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] } }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Disk I/O",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "rate(node_disk_read_bytes_total{instance=\"$instance\"}[5m])", "legendFormat": "{{device}} read", "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } },
        { "expr": "rate(node_disk_written_bytes_total{instance=\"$instance\"}[5m])", "legendFormat": "{{device}} write", "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 12, "type": "row", "title": "Network", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": [] },
    {
      "id": 13, "type": "timeseries", "title": "Network I/O",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{instance=\"$instance\", device!~\"lo|veth.*|docker.*|br-.*\"}[5m])", "legendFormat": "{{device}} rx", "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } },
        { "expr": "rate(node_network_transmit_bytes_total{instance=\"$instance\", device!~\"lo|veth.*|docker.*|br-.*\"}[5m])", "legendFormat": "{{device}} tx", "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 14, "type": "row", "title": "Environment", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "panels": [] },
    {
      "id": 15, "type": "timeseries", "title": "Temperature (if reported)",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [{ "expr": "node_thermal_zone_temp{instance=\"$instance\"}", "legendFormat": "zone {{zone}}", "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" } }],
      "fieldConfig": { "defaults": { "unit": "celsius", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 75 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 16, "type": "row", "title": "Logs", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }, "panels": [] },
    {
      "id": 17, "type": "logs", "title": "Recent Logs (best-effort match on Loki host label)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 41 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [{ "expr": "{host=\"$instance\"}", "refId": "A", "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" } }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true }
    }
  ]
}
