            "renameByName": {
              "nodename": "Hostname",
              "sysname": "OS Kernel",
              "release": "Kernel Release",
              "machine": "Architecture",
              "version": "Kernel Build"
            },
            "indexByName": {
              "nodename": 0,
              "sysname": 1,
              "release": 2,
              "machine": 3,
              "version": 4
            }
          }
