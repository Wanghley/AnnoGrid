# -------------------------------------------------------------------
# anno-gw-vps-macauba-01 — Gateway Node (VPS, public ingress + Grafana)
# Copy to .env and fill in real values before `docker compose up -d`.
# -------------------------------------------------------------------

# This VPS's own Tailscale IP (after `tailscale up` — see setup.sh).
# node-exporter and Grafana bind here only, never 0.0.0.0 — this box has a
# public IP, so an unbound port would be internet-exposed, not just
# LAN-exposed. (Grafana is still reachable publicly, but only via the
# Cloudflare Tunnel below, not by this bound port.)
TAILSCALE_IP=100.x.x.x

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels).
# In the same dashboard, add Public Hostname rules:
#   grafana.<domain>      -> http://grafana:3000        (internal docker net)
#   alertmanager.<domain> -> http://<GATEWAY_IP>:9093    (over Tailscale)
CF_TUNNEL_TOKEN=

# Tailscale IP of anno-gw-mon-rpi3bp-01 / mon-capitao (the monitoring Pi).
# Used for:
#   - this node's own promtail pushing logs there
#   - Grafana's Prometheus/Loki/Alertmanager datasources (see
#     grafana-provisioning/datasources/datasources.yml)
GATEWAY_IP=100.78.7.53

NODE_NAME=anno-gw-vps-macauba-01

# --- Grafana ---------------------------------------------------------
# CHANGE THE PASSWORD — do not deploy with a default.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=https://grafana.yourdomain.com

# Grafana's own backend DB. Leave GF_DATABASE_TYPE unset/blank to use the
# default local sqlite (simplest — fine for a single Grafana instance).
# Set these to point Grafana at the central Postgres on anno-db-oci-01
# instead, if you want its config/dashboards/users to survive this
# container being destroyed without depending on the grafana-data volume.
GF_DATABASE_TYPE=
GF_DATABASE_HOST=
GF_DATABASE_NAME=
GF_DATABASE_USER=
GF_DATABASE_PASSWORD=
