# -------------------------------------------------------
# AnnoGrid Node Monitoring Sidecar — environment config
# Copy this file to .env and fill in the values.
# -------------------------------------------------------

# This node's own Tailscale IP (`tailscale ip -4`). REQUIRED: docker-proxy (:2375), node-exporter (:9100)
# and cAdvisor (:8082) are published ONLY on this address. If it were empty they would bind to
# every interface, including a public one — so the compose file refuses to start without it.
TAILSCALE_IP=100.x.y.z

# Tailscale IP of the monitoring hub (Loki :3100 / Prometheus).
GATEWAY_IP=100.85.193.50

# Unique node name — used as a Loki label and Prometheus nodename.
# Follow the convention: anno-<role>-<hw>-<seq>
#   anno-nas-rpi3b-01
#   anno-gw-mon-rpi3b-01
#   anno-app-opi3b-01
NODE_NAME=anno-<role>-<hw>-<seq>
