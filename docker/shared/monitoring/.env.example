# -------------------------------------------------------
# AnnoGrid Node Monitoring Sidecar — environment config
# Copy this file to .env and fill in the values.
# -------------------------------------------------------

# Tailscale IP of the Orin hub running Loki (port 3100)
GATEWAY_IP=100.85.193.50

# Unique node name — used as a Loki label and Prometheus nodename.
# Follow the convention: anno-<role>-<hw>-<seq>
#   anno-nas-rpi3b-01
#   anno-gw-mon-rpi3b-01
#   anno-app-opi3b-01
NODE_NAME=anno-<role>-<hw>-<seq>
