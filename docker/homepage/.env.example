# -------------------------------------------------------
# homepage — environment config
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# -------------------------------------------------------

TZ=America/Sao_Paulo

# ── API Keys ──────────────────────────────────────────
# Portainer: Account Settings → Access Tokens
HOMEPAGE_VAR_PORTAINER_KEY=replace-with-portainer-api-token

# Jellyfin: Dashboard → API Keys → +
HOMEPAGE_VAR_JELLYFIN_KEY=replace-with-jellyfin-api-key

# Grafana: use a viewer account or admin
HOMEPAGE_VAR_GRAFANA_USER=admin
HOMEPAGE_VAR_GRAFANA_PASS=replace-with-grafana-password

# ── AI node service ports ─────────────────────────────
# Match values in docker/ai-jetson-orin/litellm/.env
HOMEPAGE_VAR_LITELLM_PORT=4000
HOMEPAGE_VAR_OPEN_WEBUI_PORT=8080

# ── Production / External URLs ────────────────────────
# Set these to your Cloudflare tunnel or reverse proxy URLs.
# If left unset, the dashboard falls back to Tailscale IPs.
#
# Example (Cloudflare tunnel with subdomain routing):
#   JELLYFIN_URL=https://jellyfin.yourdomain.com
#   N8N_URL=https://n8n.yourdomain.com
#
JELLYFIN_URL=
N8N_URL=
MONICA_URL=
TWENTY_URL=
PORTAINER_URL=
GRAFANA_URL=
OPENWEBUI_URL=
LITELLM_URL=
PROMETHEUS_URL=
ALERTMANAGER_URL=
NETDATA_URL=
HOMELABLE_URL=
