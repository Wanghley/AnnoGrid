# Copy to .env and fill in the password you used in sql/create-db.sql.
# Both vars point at the same place — no connection pooler in front of
# this Postgres, so pooled vs. direct is the same URL here. Reaches
# Postgres over its Tailscale IP, not a docker network join — verified
# working (full authenticated round-trip, not just a port check).
POSTGRES_PRISMA_URL=postgresql://spliit:CHANGE_ME@100.111.147.14:5432/spliit
POSTGRES_URL_NON_POOLING=postgresql://spliit:CHANGE_ME@100.111.147.14:5432/spliit

# Public URL this instance is reachable at. Defaults to http://localhost:3000.
# BASE_URL=https://spliit.wanghley.com

# Default currency pre-selected when creating a new group. Defaults to USD.
# DEFAULT_CURRENCY_CODE=USD

# Opt-in features — uncomment to enable. See the upstream README for what
# each needs: https://github.com/spliit-app/spliit#readme

# Attach images to expenses — using self-hosted MinIO, not AWS S3.
# Run minio-setup.sh first (creates a bucket-scoped user rather than
# using MinIO's root credentials here) and fill in the key/secret it
# prints. Region is arbitrary for MinIO (it doesn't enforce AWS
# regions) — us-east-1 is just the common S3-client default.
ENABLE_EXPENSE_DOCUMENTS=true
S3_UPLOAD_KEY=spliit
S3_UPLOAD_SECRET=CHANGE_ME
S3_UPLOAD_BUCKET=spliit-vps-macauba
S3_UPLOAD_REGION=us-east-1
S3_UPLOAD_ENDPOINT=http://100.111.147.14:9000

# Create expenses by scanning receipts (requires OpenAI and expense documents):
# ENABLE_RECEIPT_EXTRACT=true
# OPENAI_API_KEY=

# Auto-suggest the expense category from its title (requires OpenAI):
# ENABLE_CATEGORY_EXTRACT=true
# OPENAI_API_KEY=

# OpenAI options for the receipt and category features (see the README).
# OPENAI_BASE_URL=          # OpenAI-compatible endpoint; defaults to OpenAI
# OPENAI_MODEL_RECEIPT_EXTRACT=gpt-5-nano
# OPENAI_MODEL_CATEGORY_EXTRACT=gpt-5-nano

# Analytics is disabled unless a provider is selected.
# ANALYTICS_PROVIDER=plausible
# PLAUSIBLE_DOMAIN=your-domain.com
