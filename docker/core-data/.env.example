# Place next to docker-compose.yml as .env
# Deployed on anno-db-oci-01 — see ../../nodes/anno-db-oci-01/README.md

# Tailscale IP of THIS host — every port is bound to this address only.
# Get it after `tailscale up` with: tailscale ip -4
TAILSCALE_IP=100.x.x.x

# ── PostgreSQL ──
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_secure_password
POSTGRES_DB=postgres

# ── MariaDB ──
MYSQL_ROOT_PASSWORD=your_mariadb_root_password
MYSQL_USER=your_mariadb_user
MYSQL_PASSWORD=your_mariadb_secure_password
MYSQL_DATABASE=your_mariadb_database_name

# ── Redis ──
REDIS_PASSWORD=your_redis_secure_password

# ── CouchDB ──
# No COUCHDB_USER/COUCHDB_PASSWORD here — the admin credential is baked
# into configs/couchdb/local.d/docker.ini (a pre-hashed [admins] entry),
# not env-driven. See the couchdb service's comment in docker-compose.yml.

# ── MinIO ──
MINIO_ROOT_USER=your_minio_admin_user
MINIO_ROOT_PASSWORD=your_minio_secure_password
