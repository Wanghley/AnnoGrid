# Copy to .env and fill in real values before starting.
#
# When adding additional environment variables, split-pro's own
# src/env.js schema should be checked too — see upstream's .env.example
# for the authoritative, up-to-date list:
# https://github.com/oss-apps/split-pro/blob/main/.env.example

#********* This compose file's own vars (not upstream's) *********

# Host-side published port. Not 3000 — that's already taken by Grafana
# on this box. Only the app is published; the bundled Postgres stays
# fully internal to this compose project, no host port at all.
HOST_PORT=7576

# Never 0.0.0.0, same convention as every other exposed port on this
# host.
TAILSCALE_IP=100.111.147.14

#********* REQUIRED ENV VARS (from upstream) *********

# These also name/initialize the bundled postgres container — this is
# a dedicated Postgres for split-pro only, not the shared
# core-data-postgres instance (see docker-compose.yml's header comment
# for why: split-pro's Prisma schema requires the pg_cron extension,
# which the shared instance doesn't have).
POSTGRES_CONTAINER_NAME=splitpro-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=splitpro
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@splitpro-db:5432/${POSTGRES_DB}

# Next Auth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME
# Update once you've decided the public hostname (e.g. via Cloudflare
# Tunnel, same pattern as Homarr/Grafana elsewhere in this repo).
NEXTAUTH_URL=http://localhost:3000

# The default /home page is a blog page that may not fit your use
# case — /balances is the more typical choice for a private instance.
DEFAULT_HOMEPAGE=/balances

ENABLE_SENDING_INVITES=false
DISABLE_EMAIL_SIGNUP=false

#********* OPTIONAL ENV VARS (from upstream — see their README for details) *********

# Deletes old cached bank data / currency rates on this schedule.
# Requires pg_cron, which this deployment has (see docker-compose.yml).
# CLEAR_CACHE_CRON_RULE="0 2 * * 0"
# CACHE_RETENTION_INTERVAL="2 days"

# SMTP (for magic-link/OTP email signin, if DISABLE_EMAIL_SIGNUP=false)
# FROM_EMAIL=
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_TLS_REJECT_UNAUTHORIZED=1

# GoCardless bank integration
# GOCARDLESS_COUNTRY=
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=
# GOCARDLESS_INTERVAL_IN_DAYS=

# Plaid bank integration
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENVIRONMENT=
# PLAID_COUNTRY_CODES=
# PLAID_INTERVAL_IN_DAYS=

# OAuth providers
# OAUTH_AUTO_REDIRECT=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTHENTIK_ID=
# AUTHENTIK_SECRET=
# AUTHENTIK_ISSUER=
# KEYCLOAK_ID=
# KEYCLOAK_SECRET=
# KEYCLOAK_ISSUER=
# OIDC_NAME=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_WELL_KNOWN_URL=
# OIDC_ALLOW_DANGEROUS_EMAIL_LINKING=1

# Web Push notifications — generate with: npx web-push generate-vapid-keys --json
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_EMAIL=

# FEEDBACK_EMAIL=
# DISCORD_WEBHOOK_URL=

# Currency rate provider: frankfurter (default), openexchangerates, or nbp
# CURRENCY_RATE_PROVIDER=frankfurter
# OPEN_EXCHANGE_RATES_APP_ID=

# UPLOAD_MAX_FILE_SIZE_MB=10
