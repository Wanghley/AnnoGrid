# Copy to .env and fill in real values before starting.
# Full option list: https://docs.tandoor.dev/system/configuration/

# Generate with: openssl rand -base64 50 | tr -d '\n'
SECRET_KEY=CHANGE_ME

TZ=UTC

# Must match the hostname you'll actually reach this at.
ALLOWED_HOSTS=recipes.wanghley.com

# Reuses the shared Postgres instance over its Tailscale IP (verified
# working pattern — see docker/spliit's history in this repo for why
# that's the approach, not joining core-data's docker network
# directly). Run sql/create-db.sql first — or if reusing the tandoor_db
# that already exists from a previous attempt, just create the tandoor
# user and GRANT it, skip the CREATE DATABASE line.
DB_ENGINE=django.db.backends.postgresql
POSTGRES_HOST=100.111.147.14
POSTGRES_PORT=5432
POSTGRES_DB=tandoor_db
POSTGRES_USER=tandoor
POSTGRES_PASSWORD=CHANGE_ME
