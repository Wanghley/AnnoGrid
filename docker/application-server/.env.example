# Place next to setup.sh / manage.sh as .env
# Shared by docker-compose.db.yml, docker-compose.app.yml, docker-compose.mon.yml

# ── Centralized DB host (anno-db-oci-01, OCI VPS, over Tailscale) ──
# Was "postgres" / "mariadb" (local container names) before the DB
# migration — see docs/guides/db-migration-to-oci.md
ANNOGRID_DB_HOST=anno-db-oci-01.<your-tailnet>.ts.net

# ── Postgres (used by legacy n8n service + postgres-exporter) ──
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_secure_password
POSTGRES_DB=your_postgres_database_name

# ── MariaDB (used by monica + mysqld-exporter) ──
MYSQL_ROOT_PASSWORD=your_mariadb_root_password
MYSQL_USER=your_mariadb_user
MYSQL_PASSWORD=your_mariadb_secure_password
MYSQL_DATABASE=your_mariadb_database_name

# ── Monica ──
MONICA_APP_KEY=replace-with-output-of-openssl-rand-base64-32
MONICA_URL=http://100.x.x.x:8080

# ── Legacy n8n service in docker-compose.app.yml ──
# (confirm this is actually the live n8n before relying on it — see RESTORE.md)
N8N_USER=admin
N8N_PASSWORD=replace-with-strong-password

# ── Jellyfin ──
TZ=America/New_York
MEDIA_PATH=/path/to/media
