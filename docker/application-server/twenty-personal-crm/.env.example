# Place next to docker-compose.yml as .env

NODE_PORT=3000

# Public URL — must match what the browser resolves (Tailscale IP/port or domain)
SERVER_URL=http://100.x.x.x:3000

# Data layer — anno-db-oci-01 (OCI VPS), reached over Tailscale.
# Postgres/Redis were previously local containers on the core-data_default
# network; see docs/guides/db-migration-to-oci.md.
PG_DATABASE_URL=postgres://twenty:replace-with-strong-password@anno-db-oci-01.<your-tailnet>.ts.net:5432/twenty
REDIS_URL=redis://:replace-with-strong-password@anno-db-oci-01.<your-tailnet>.ts.net:6379

# 32+ char secret for JWT signing and field-level encryption.
# MUST be stable — losing/rotating this makes existing encrypted fields unreadable.
# Generate with: openssl rand -base64 32
APP_SECRET=replace-with-output-of-openssl-rand-base64-32

# Only needed if bind-mounting local storage outside the default ./data/storage
STORAGE_HOST_PATH=./data/storage
