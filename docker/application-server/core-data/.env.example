# DEPRECATED 2026-09-07 — these services now run on nodes/anno-db-oci-01/
# (see docker-compose.yml in this directory and docs/guides/db-migration-to-oci.md).
# Use nodes/anno-db-oci-01/.env.example instead; kept here for reference only.

# PostgreSQL Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_secure_password
POSTGRES_DB=your_postgres_database_name

# MariaDB Configuration
MARIADB_ROOT_PASSWORD=your_mariadb_root_password
MARIADB_USER=your_mariadb_user
MARIADB_PASSWORD=your_mariadb_secure_password
MARIADB_DATABASE=your_mariadb_database_name

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=your_mongo_admin_user
MONGO_INITDB_ROOT_PASSWORD=your_mongo_secure_password

# Redis Configuration
REDIS_PASSWORD=your_redis_secure_password

# MinIO Configuration
MINIO_ROOT_USER=your_minio_admin_user
MINIO_ROOT_PASSWORD=your_minio_secure_password
