# Place next to docker-compose.yml
# Rotate ALL of these — the old ones were exposed in a public message

# Postgres password (already in your DB; if you change this, update postgres too)
DB_TYPE=postgres
# Tailscale IP or MagicDNS name of anno-db-oci-01 (was "postgres" when the DB
# ran as a local container — see docs/guides/db-migration-to-oci.md)
DB_POSTGRESDB_HOST=anno-db-oci-01.<your-tailnet>.ts.net
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=replace-with-new-strong-password

# n8n encryption key — MUST be stable. If lost, all stored credentials become unreadable.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32

# Shared secret between n8n and n8n-runner
# Generate with: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=replace-with-output-of-openssl-rand-hex-32
