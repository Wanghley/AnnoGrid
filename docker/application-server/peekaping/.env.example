# ==============================================================================
# Peekaping Stack - Environment Configuration Template
# ==============================================================================

# Database Target — anno-db-oci-01 (OCI VPS), reached over Tailscale.
# Was "postgres" (local core-data container) before the DB migration —
# see docs/guides/db-migration-to-oci.md.
PEEKAPING_DB_HOST=anno-db-oci-01.<your-tailnet>.ts.net
PEEKAPING_DB_PORT=5432
PEEKAPING_DB_NAME=peekaping
PEEKAPING_DB_USER=peekaping_user
PEEKAPING_DB_PASSWORD=your_fallback_strong_password_here

# Redis Target — same host
REDIS_HOST=anno-db-oci-01.<your-tailnet>.ts.net
REDIS_PORT=6379
REDIS_PASS=your_redis_secure_password

# api/producer/worker/ingester run mode (see peekaping docs)
MODE=prod

# Global Container Engine Settings
TZ=America/New_York
