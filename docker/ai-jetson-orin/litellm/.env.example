# LiteLLM + Open WebUI + SearXNG + speaches on ai-jacaranda.
# Copy to .env and fill in the placeholders. setup.sh generates/mints everything marked "auto".

# ── Local Postgres (litellm-postgres sidecar) ───────────────────
# docker-compose.yml builds DATABASE_URL from this — don't set DATABASE_URL here.
# auto (hex only: a URL-unsafe character would break the connection string)
POSTGRES_PASSWORD=<auto>

# ── LiteLLM Admin Settings ──────────────────────────────────────
LITELLM_MASTER_KEY=sk-<key>          # admin only — clients use the scoped keys below
UI_PASSWORD=<pass>
LITELLM_PORT=4001

# ── Open WebUI Settings ─────────────────────────────────────────
OPEN_WEBUI_PORT=8080
WEBUI_SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">
HF_TOKEN=<optional huggingface token>

# ── SearXNG (private web search for Open WebUI) ─────────────────
SEARXNG_SECRET=<auto>

# ── Scoped LiteLLM virtual keys — auto-minted by setup.sh via new-key.sh ──
OPENWEBUI_LITELLM_KEY=<auto>         # Open WebUI: every model, no admin routes
LITELLM_KEY_IDE=<auto>               # IDE plugins: code/chat/embed only, 60 rpm
LITELLM_KEY_SCRIPTS=<auto>           # scripts: local models only, $5/30d, 30 rpm
LITELLM_KEY_PROMETHEUS=<auto>        # metrics scrape: /metrics only (see nodes/mon-capitao)

# Ollama runs on the HOST (systemd), not in Docker. extra_hosts maps
# host.docker.internal to the host gateway.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Cloud Provider API Keys ─────────────────────────────────────
# OpenRouter (200+ models via one key): https://openrouter.ai/keys
# Not currently wired into config.yaml — see the commented block there.
OPENROUTER_API_KEY=<your-openrouter-key>

# ── Global Budget Cap ───────────────────────────────────────────
# Hard stop when cumulative cloud spend hits this (USD, resets monthly)
LITELLM_MAX_BUDGET=20
